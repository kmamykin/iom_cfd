/*--------------------------------*- C++ -*----------------------------------*\
| fullboat template (OpenFOAM v2512, interFoam VOF, water + air).             |
| Values come from system/caseParameters, written by iomcfd. EXPERIMENTAL.    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kWater;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, symmetryPlane...

    inletWater      { type fixedValue; value uniform $kWater; }
    inletAir        { type fixedValue; value uniform $kAir; }
    "outlet(Water|Air)"
    {
        type            inletOutlet;
        inletValue      uniform $kWater;
        value           uniform $kWater;
    }
    boat
    {
        type            kqRWallFunction;
        value           uniform $kWater;
    }
    rig
    {
        type            kqRWallFunction;
        value           uniform $kWater;
    }
}
