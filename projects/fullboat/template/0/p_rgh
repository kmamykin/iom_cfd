/*--------------------------------*- C++ -*----------------------------------*\
| fullboat template (OpenFOAM v2512, interFoam VOF, water + air).             |
| Values come from system/caseParameters, written by iomcfd. EXPERIMENTAL.    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, symmetryPlane...

    "inlet(Water|Air)"  { type fixedFluxPressure; value uniform 0; }
    outletWater         { type zeroGradient; }
    outletAir           { type totalPressure; p0 uniform 0; }
    boat            { type fixedFluxPressure; value uniform 0; }
    rig             { type fixedFluxPressure; value uniform 0; }
}
