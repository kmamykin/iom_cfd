/*--------------------------------*- C++ -*----------------------------------*\
| fullboat template (OpenFOAM v2512, interFoam VOF, water + air).             |
| system/caseParameters, written by iomcfd from the study YAML.               |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    boat.stl                // solids: hull (+ fin, bulb, rudder...) -> patches boat_<solid>
    {
        type    triSurfaceMesh;
        name    boat;
    }
    nearBox     { type searchableBox; min $nearBoxMin; max $nearBoxMax; }
    waveBox     { type searchableBox; min $waveBoxMin; max $waveBoxMax; }   // Kelvin wave pattern
    rigBox      { type searchableBox; min $rigBoxMin; max $rigBoxMax; }     // around the sails
    main.stl    { type triSurfaceMesh; name main; }     // sails: zero-thickness baffles
    jib.stl     { type triSurfaceMesh; name jib; }
    mast.stl    { type triSurfaceMesh; name mast; }
}

castellatedMeshControls
{
    maxLocalCells       5000000;
    maxGlobalCells      40000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "boat.eMesh"; level $featureLevel; }
        { file "rig.eMesh"; level $rigFeatureLevel; }
    );

    refinementSurfaces
    {
        boat
        {
            level       ($surfaceLevelMin $surfaceLevelMax);
            patchInfo   { type wall; inGroups (boat); }
        }
        main
        {
            level       ($rigLevelMin $rigLevelMax);
            faceZone    main;
            faceType    baffle;
            patchInfo   { type wall; inGroups (rig sails); }
        }
        jib
        {
            level       ($rigLevelMin $rigLevelMax);
            faceZone    jib;
            faceType    baffle;
            patchInfo   { type wall; inGroups (rig sails); }
        }
        mast
        {
            level       ($rigLevelMin $rigLevelMax);
            patchInfo   { type wall; inGroups (rig); }
        }
    }

    resolveFeatureAngle 25;

    refinementRegions
    {
        nearBox { mode inside; levels ((1e15 $nearBoxLevel)); }
        waveBox { mode inside; levels ((1e15 $waveBoxLevel)); }
        rigBox  { mode inside; levels ((1e15 $rigBoxLevel)); }
    }

    locationInMesh      $locationInMesh;
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          100;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    layers
    {
        "boat_.*" { nSurfaceLayers $nLayers; }
        "(main|jib|mast).*" { nSurfaceLayers 1; }
    }
    expansionRatio      1.3;
    finalLayerThickness 0.6;
    minThickness        0.2;
    nGrow               0;
    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    #includeEtc "caseDicts/meshQualityDict"
    nSmoothScale    4;
    errorReduction  0.75;
}

mergeTolerance 1e-6;
