FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

vertices
(
    ($xMin $yMin $zMin) ($xMax $yMin $zMin) ($xMax $yMax $zMin) ($xMin $yMax $zMin)
    ($xMin $yMin $zMax) ($xMax $yMin $zMax) ($xMax $yMax $zMax) ($xMin $yMax $zMax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

boundary
(
    inlet   { type patch; inGroups (freestream); faces ((0 4 7 3)); }
    outlet  { type patch; inGroups (freestream); faces ((1 2 6 5)); }
    sides   { type patch; inGroups (freestream); faces ((0 1 5 4) (3 7 6 2)); }
    top     { type patch; inGroups (freestream); faces ((4 5 6 7)); }
    water   { type patch; faces ((0 3 2 1)); }     // slip: the water surface
);
