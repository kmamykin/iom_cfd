/*--------------------------------*- C++ -*----------------------------------*\
| bulb2d template (OpenFOAM v2512). Values come from system/caseParameters,   |
| which iomcfd writes from the study YAML.                                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

application     simpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         $maxIter;
deltaT          1;

writeControl    timeStep;
writeInterval   $maxIter;       // only the final state (plus on convergence)
purgeWrite      1;
writeFormat     binary;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;    // iomcfd sets 'stopAt writeNow' once forces have converged

functions
{
    // Drag coefficient on the wetted area every iteration. The mesh is a
    // wedge of the body: Aref is the wedge's share of the wetted area (no
    // base), so Cd is the whole body's C_D,wet. e1 = along the axis.
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        patches         (wall);         // body + base (patch group)
        rho             rhoInf;
        rhoInf          $rhoInf;
        magUInf         $magUInf;
        lRef            $lRef;
        Aref            $Aref;
        origin          (0 0 0);
        e1              (1 0 0);
        e3              (0 1 0);
    }

    // Dimensional forces on the wedge, split into pressure and viscous
    // parts: body and base separately (generated: forces_body, forces_base)
    #include "include/forceFunctions"

    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p k omega ReThetat gammaInt);
        writeResidualFields false;
    }

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        log             false;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (wall);
        writeControl    writeTime;
        log             false;
    }

    // Surface p and wall shear stress at the final time (Cp / Cf along the
    // body, transition and separation points).
    bodySurface
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          (p wallShearStress);
        surfaces
        {
            body
            {
                type        patch;
                patches     (body);
                interpolate false;
            }
        }
    }
}


