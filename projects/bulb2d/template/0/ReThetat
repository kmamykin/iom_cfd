FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      ReThetat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 0 0 0 0 0 0];

internalField   uniform $ReThetatInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, wedge...

    wall                // patch group: body + base
    {
        type            zeroGradient;
    }
    freestream
    {
        type            inletOutlet;
        inletValue      uniform $ReThetatInf;
        value           uniform $ReThetatInf;
    }
}
