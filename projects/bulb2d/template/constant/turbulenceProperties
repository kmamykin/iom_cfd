/*--------------------------------*- C++ -*----------------------------------*\
| bulb2d template (OpenFOAM v2512). Values come from system/caseParameters,   |
| which iomcfd writes from the study YAML.                                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

simulationType  RAS;

RAS
{
    RASModel        $turbModel;     // kOmegaSSTLM or kOmegaSST
    turbulence      on;
    printCoeffs     on;

    // Freestream "sustaining" terms (Spalart & Rumsey 2007): without them k
    // decays between the far field and the body, so the Tu that drives
    // transition would depend on the domain size.
    kOmegaSSTCoeffs
    {
        decayControl    $decayControl;
        kInf            $kInf;
        omegaInf        $omegaInf;
    }
    kOmegaSSTLMCoeffs
    {
        $kOmegaSSTCoeffs;
    }
}
