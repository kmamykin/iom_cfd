/*--------------------------------*- C++ -*----------------------------------*\
| foil2d template (OpenFOAM v2512). Values come from system/caseParameters,   |
| which iomcfd writes from the study YAML.                                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, cyclic, empty...

    foil
    {
        type            omegaWallFunction;    // switches to the viscous-sublayer value at y+ < 1
        value           uniform $omegaInf;
    }
    freestream
    {
        type            inletOutlet;
        inletValue      uniform $omegaInf;
        value           uniform $omegaInf;
    }
    frontAndBack
    {
        type            empty;
    }
}
