/*--------------------------------*- C++ -*----------------------------------*\
| foil2d template (OpenFOAM v2512). Values come from system/caseParameters,   |
| which iomcfd writes from the study YAML.                                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform $nutInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, cyclic, empty...

    foil
    {
        type            nutLowReWallFunction;   // nut = 0 at a resolved wall
        value           uniform 0;
    }
    freestream
    {
        type            calculated;
        value           uniform $nutInf;
    }
    frontAndBack
    {
        type            empty;
    }
}
