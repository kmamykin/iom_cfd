FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $Uinf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, cyclic, empty...

    boat            // patch group: one patch per STL solid (hull, fin, bulb)
    {
        type            noSlip;
    }
    freestream      // inlet, outlet, sides, bottom
    {
        type            freestreamVelocity;
        freestreamValue uniform $Uinf;
    }
    top             // waterline, modelled as a mirror plane (no waves)
    {
        type            symmetryPlane;
    }
}
