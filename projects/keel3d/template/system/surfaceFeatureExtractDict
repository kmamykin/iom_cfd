FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

boat.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       150;    // edges sharper than 30 deg (fin trailing edge)
    subsetFeatures
    {
        nonManifoldEdges    no;
        openEdges           yes;
    }
    // Fin-hull and fin-bulb junction lines: intersections between STL solids.
    // "region" finds none (0 edges in every canoe-body run so far; snappy's
    // multiRegionFeatureSnap made the junctions); "self" finds them, and is
    // used with an STL hull (project.py: featureIntersection).
    intersectionMethod  $featureIntersection;
    writeObj            no;
}
