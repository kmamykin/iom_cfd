/*--------------------------------*- C++ -*----------------------------------*\
| hull template (OpenFOAM v2512, interFoam VOF). Values come from             |
| system/caseParameters, written by iomcfd from the study YAML.               |
| Derived from the OpenFOAM DTCHull / DTCHullMoving tutorials.                |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $Uinf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, symmetryPlane...

    inlet
    {
        type            fixedValue;
        value           uniform $Uinf;
    }
    outlet          // keeps the mean water velocity = boat speed
    {
        type            outletPhaseMeanVelocity;
        alpha           alpha.water;
        Umean           $magUInf;
        value           uniform $Uinf;
    }
    atmosphere
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    boat
    {
        type            movingWallVelocity;     // = noSlip when the mesh is static
        value           uniform (0 0 0);
    }
}
