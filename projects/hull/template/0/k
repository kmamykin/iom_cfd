FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInf;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, symmetryPlane...

    inlet
    {
        type            fixedValue;
        value           uniform $kInf;
    }
    "(outlet|atmosphere)"
    {
        type            inletOutlet;
        inletValue      uniform $kInf;
        value           uniform $kInf;
    }
    boat
    {
        type            kqRWallFunction;
        value           uniform $kInf;
    }
}
