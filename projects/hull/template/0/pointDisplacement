FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointDisplacement;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // processor, symmetryPlane...

    "(inlet|outlet|atmosphere)"
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    boat
    {
        type            calculated;     // set by the rigid-body motion solver
    }
}
