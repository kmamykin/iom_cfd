/*--------------------------------*- C++ -*----------------------------------*\
| hull template (OpenFOAM v2512, interFoam VOF). Values come from             |
| system/caseParameters, written by iomcfd from the study YAML.               |
| Derived from the OpenFOAM DTCHull / DTCHullMoving tutorials.                |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        box (-1e3 -1e3 -1e3) (1e3 1e3 0);
        fieldValues ( volScalarFieldValue alpha.water 1 );
    }
    boxToFace       // inlet patch values below the waterline
    {
        box (-1e3 -1e3 -1e3) (1e3 1e3 0);
        fieldValues ( volScalarFieldValue alpha.water 1 );
    }
);
