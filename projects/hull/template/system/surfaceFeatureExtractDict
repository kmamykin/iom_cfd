FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

boat.stl
{
    extractionMethod    extractFromSurface;
    includedAngle       150;    // edges sharper than 30 deg (trailing edges, tips)
    subsetFeatures
    {
        nonManifoldEdges    no;
        openEdges           yes;
    }
    // Hull/appendage junction lines: intersections between different STL solids
    intersectionMethod  region;
    writeObj            no;
}
