FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParameters"

phases          (water air);

water
{
    transportModel  Newtonian;
    nu              $nuWater;
    rho             $rhoWater;
}

air
{
    transportModel  Newtonian;
    nu              $nuAir;
    rho             $rhoAir;
}

sigma           0;      // surface tension is negligible at these scales (We >> 1)
