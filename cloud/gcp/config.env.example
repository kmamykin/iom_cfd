# Copy to config.env (git-ignored) and fill in. Read by `make push`,
# cloud/gcp/setup.sh and `iomcfd gcp ...`.

GCP_PROJECT=my-gcp-project-id
GCP_REGION=us-central1

# Artifact Registry docker repository and image name
AR_REPO=iom-cfd
IMAGE_NAME=iom-cfd
# `make push` pushes both a git-describe tag and latest; pin one for reproducibility
IMAGE_TAG=latest

# Results bucket (gs:// is added automatically); must be globally unique
GCS_BUCKET=my-iom-cfd-results

# Service account the Batch VMs run as (created by setup.sh)
BATCH_SA=iom-cfd-batch@my-gcp-project-id.iam.gserviceaccount.com

# Default VM type for `iomcfd gcp submit` (override with --machine).
#   2D sweeps:   c3d-standard-16 (Spot, 8 one-core cases per VM)
#   3D / hull:   h3-standard-88  (88 real cores, built for CFD; us-central1-a only)
DEFAULT_MACHINE=c3d-standard-16
