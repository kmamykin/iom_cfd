# Simulation output (rendered cases, logs, fields). Large; never commit. No trailing slash: in a
# worktree runs may be a link to the main checkout's runs/.
/runs
# Downloaded cloud results
/cloud-results/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
dist/
build/

# OpenFOAM artefacts if a template is ever run in place
# (time directories other than 0/: 0/ holds the initial conditions and is source)
projects/*/template/[1-9]*/
projects/*/template/0.*/
projects/*/template/0[eE]*/
projects/*/template/processor*/
projects/*/template/postProcessing/
projects/*/template/log.*
projects/*/template/constant/polyMesh/

# Local cloud configuration (project ids, bucket names) and submitted Batch job specs
cloud/gcp/config.env
cloud/gcp/jobs/

# OS / editors
.DS_Store
*.swp
.idea/
.vscode/

# Website build output (`iomcfd site build`); site/data and site/assets are source
/site/_site/
/site/_generated/
/site/.quarto/
/site/**/index_files/
